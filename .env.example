# Copy to .env for local development. Never commit .env.
# Values below are placeholders. Do not put production credentials here.

# Application
APP_ENV=
APP_BASE_URL=
API_BASE_URL=

# PostgreSQL (local development only). Fill these in .env. See docs/development.md.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=

# Microsoft Entra ID. Leave these empty until a real app registration exists.
# The API does not call Microsoft when any value is empty.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# SESSION_TTL_SECONDS defaults to 28800. SESSION_COOKIE_SECURE defaults to true.
# Local preview sign-in. Leave false. It works only from localhost when set true.
PREVIEW_LOGIN_ENABLED=false

# Private object storage. Leave unset while using the mock provider.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Email. See docs/mailbox.md. Live sending stays disabled.
EMAIL_PROVIDER=
EMAIL_LIVE_SEND_ENABLED=false
# Comma-separated recipient domains. Empty allows any valid address.
EMAIL_ALLOWED_RECIPIENT_DOMAINS=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHARED_MAILBOX_ADDRESS=

# Model access. No provider key is required for the mock adapter.
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_NAME=

# Durable workflow engine. Compose publishes Temporal on localhost:7233.
# Leave the address empty to keep runs in PostgreSQL only.
WORKFLOW_PROVIDER=
WORKFLOW_ADDRESS=
