# Copy to .env for local development. Never commit .env.
# Values below are placeholders. Do not put production credentials here.

# Application
APP_ENV=
APP_BASE_URL=
# Links that leave the app (the upload link in emails, the welcome email's sign-in link)
# point here when set, for example http://192.168.1.20:3000 for devices on the network.
PUBLIC_BASE_URL=
# 0.0.0.0 lets other devices on the network open the workspace (make web / make go).
WEB_HOST=
API_BASE_URL=

# PostgreSQL (local development only). Fill these in .env. See docs/development.md.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=

# Microsoft Entra ID. Leave these empty until a real app registration exists.
# The API does not call Microsoft when any value is empty.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
# Google sign-in and sign-up. Create an OAuth client (web application) in Google Cloud,
# add GOOGLE_REDIRECT_URL as an authorized redirect URI, and keep the secret out of the
# repository. The API does not call Google when any value is empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Inviting people by email checks that the address's domain receives mail (a DNS MX
# lookup; nothing is sent). Leave empty to use this machine's DNS servers, or list
# servers, comma-separated, if a dead VPN adapter slows lookups down.
DNS_NAMESERVERS=
# SESSION_TTL_SECONDS defaults to 28800. SESSION_COOKIE_SECURE defaults to true.
# Local preview sign-in. Leave false. It works only from localhost when set true.
PREVIEW_LOGIN_ENABLED=false

# Independent review. Keep true for real engagements: the reviewer must be a separate
# team member who did not test or prepare the work. false is for development only and
# lets anyone on the team review and sign off, including their own work.
REVIEW_INDEPENDENCE_REQUIRED=true

# Private object storage. Leave unset to use the mock store.
# Compose runs MinIO on localhost:9000. To use it, set the four values, for example
# S3_ENDPOINT_URL=http://localhost:9000 and S3_BUCKET=evidence, with the MinIO root
# user and password as the access key and secret. Create the bucket before the API
# stores a file. The API never logs these values.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Email. See docs/mailbox.md. Live sending needs EMAIL_PROVIDER=smtp (or gmail),
# EMAIL_LIVE_SEND_ENABLED=true, the SMTP values below, and at least one allowed domain.
EMAIL_PROVIDER=
EMAIL_LIVE_SEND_ENABLED=false
# Comma-separated recipient domains. Empty allows any valid address.
EMAIL_ALLOWED_RECIPIENT_DOMAINS=
# Local testing only: lets a signed-in team member simulate a reply arriving in the
# mock mailbox. Has no effect with any provider other than the mock.
EMAIL_MOCK_INBOUND_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHARED_MAILBOX_ADDRESS=
# Live email over SMTP: send only, to EMAIL_ALLOWED_RECIPIENT_DOMAINS. Quote a password
# that has spaces (a Gmail app password), or remove them.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Model access. Leave empty for the mock adapter, which needs no key. Set
# MODEL_PROVIDER=anthropic and MODEL_API_KEY to let the agents work with Claude.
# Never commit a real key.
MODEL_PROVIDER=
MODEL_API_KEY=
# Three tiers, each a pinned model (Milestone 3a). Empty takes the defaults: FAST
# claude-haiku-5-5 (reading and sorting evidence), BALANCED claude-sonnet-5-5 (drafting,
# testing, the screenshot review), DEEP claude-opus-5-5 (planning, the independent
# review). MODEL_NAME is the older name for the BALANCED tier's model.
MODEL_FAST=
MODEL_BALANCED=
MODEL_DEEP=
MODEL_NAME=
# Prices for a model the code does not know, in dollars per million tokens, as JSON:
# {"model-id": [input, output]}. A live model without a price is refused.
MODEL_PRICES=
# The DEEP tier runs only explicitly authorized work: the roster keys listed here, for
# example "independent-reviewer,engagement-planner". Empty by default: no agent uses it.
MODEL_DEEP_AGENTS=
# Containment: a live call outside the agent caller (no tier, budget or provenance) is
# refused unless this is true. Development only; never for a real engagement.
MODEL_ALLOW_UNMETERED=false
# Budgets in micro-dollars (1000000 = $1), enforced before a call is sent. Provisional
# development defaults: $1 a call, $10 a job, $50 an engagement a calendar month.
# 0 removes a limit. A refused call is recorded as BUDGET_EXCEEDED.
MODEL_BUDGET_CALL_MICROS=1000000
MODEL_BUDGET_JOB_MICROS=10000000
MODEL_BUDGET_ENGAGEMENT_MONTH_MICROS=50000000
# Encrypts the stored prompts and answers of agent calls: 32 random bytes, base64
# (for example `openssl rand -base64 32`). Without it only hashes are kept. The firm's
# owner or admin and the engagement's reviewer read them, with a stated purpose; every
# read is audited. MODEL_CONTENT_RETENTION_DAYS is how long they are kept.
PROVENANCE_KEY=
# Earlier keys after a rotation, comma-separated, so content sealed under them stays
# readable (docs/operations.md, "Encryption keys and rotation").
PROVENANCE_PREVIOUS_KEYS=
MODEL_CONTENT_RETENTION_DAYS=90
# Live tests against the provider (services/api/tests/test_live_model.py) run only with
# MODEL_LIVE_TESTS=1; they cost a few cents and are never part of the gate.
MODEL_LIVE_TESTS=0

# Runs background agent work (drafting evidence requests, reading stored evidence)
# inside the API when WORKFLOW_ADDRESS is empty. Turn on for local development.
LOCAL_WORKER_ENABLED=true
# Background jobs run at once (drafts, scoping reviews, scans, analyses). 1 to 16.
LOCAL_WORKER_THREADS=6

# Local OCR for screenshots and scanned pages. Leave the path empty to use `tesseract`
# on the PATH. Without Tesseract, such files wait for a person to read them. Images go
# to the model provider only when a firm owner or admin opts into model OCR.
OCR_TESSERACT_PATH=
OCR_LANGUAGES=eng

# Durable workflow engine. Compose publishes Temporal on localhost:7233.
# Leave the address empty to keep runs in PostgreSQL only.
WORKFLOW_PROVIDER=
WORKFLOW_ADDRESS=
