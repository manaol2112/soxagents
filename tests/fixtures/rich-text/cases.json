{
 "_": "The grammar of a formatted text section (docs/design-workpaper.md, section 3.3), by example. Read by the web's tests (rich-text-model: parse(text) deep-equals blocks; plain(text) equals plain) and the server's (workpaper_marks.plain(text) equals plain). A run is {t, b?, i?, u?}; a paragraph is its lines; a list is its items. Synthetic text only.",
 "cases": [
  {
   "name": "empty",
   "text": "",
   "blocks": [],
   "plain": ""
  },
  {
   "name": "one paragraph",
   "text": "HR records each termination.",
   "blocks": [
    {
     "type": "p",
     "lines": [
      [
       {
        "t": "HR records each termination."
       }
      ]
     ]
    }
   ],
   "plain": "HR records each termination."
  },
  {
   "name": "a line break and two paragraphs",
   "text": "First line\nsecond line\n\nSecond paragraph.",
   "blocks": [
    {
     "type": "p",
     "lines": [
      [
       {
        "t": "First line"
       }
      ],
      [
       {
        "t": "second line"
       }
      ]
     ]
    },
    {
     "type": "p",
     "lines": [
      [
       {
        "t": "Second paragraph."
       }
      ]
     ]
    }
   ],
   "plain": "First line\nsecond line\n\nSecond paragraph."
  },
  {
   "name": "bold, italic and underline",
   "text": "A **bold** word, an ''italic'' one and an ++underlined++ one.",
   "blocks": [
    {
     "type": "p",
     "lines": [
      [
       {
        "t": "A "
       },
       {
        "t": "bold",
        "b": true
       },
       {
        "t": " word, an "
       },
       {
        "t": "italic",
        "i": true
       },
       {
        "t": " one and an "
       },
       {
        "t": "underlined",
        "u": true
       },
       {
        "t": " one."
       }
      ]
     ]
    }
   ],
   "plain": "A bold word, an italic one and an underlined one."
  },
  {
   "name": "nested marks",
   "text": "**bold and ''both'' and ++all ''three''++**",
   "blocks": [
    {
     "type": "p",
     "lines": [
      [
       {
        "t": "bold and ",
        "b": true
       },
       {
        "t": "both",
        "b": true,
        "i": true
       },
       {
        "t": " and ",
        "b": true
       },
       {
        "t": "all ",
        "b": true,
        "u": true
       },
       {
        "t": "three",
        "b": true,
        "i": true,
        "u": true
       }
      ]
     ]
    }
   ],
   "plain": "bold and both and all three"
  },
  {
   "name": "adjacent runs of different marks",
   "text": "**a**''b''++c++",
   "blocks": [
    {
     "type": "p",
     "lines": [
      [
       {
        "t": "a",
        "b": true
       },
       {
        "t": "b",
        "i": true
       },
       {
        "t": "c",
        "u": true
       }
      ]
     ]
    }
   ],
   "plain": "abc"
  },
