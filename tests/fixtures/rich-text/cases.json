   "name": "a bold run then a bold and italic run",
   "text": "**a** **''b''**",
   "blocks": [
    {
     "type": "p",
     "lines": [
      [
       {
        "t": "a",
        "b": true
       },
       {
        "t": " "
       },
       {
        "t": "b",
        "b": true,
        "i": true
       }
      ]
     ]
    }
