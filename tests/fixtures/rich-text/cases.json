  {
   "name": "underscores are never marks",
   "text": "acme_prod, __init__ and user_id",
   "blocks": [
    {
     "type": "p",
     "lines": [
      [
       {
        "t": "acme_prod, __init__ and user_id"
       }
      ]
     ]
    }
   ],
   "plain": "acme_prod, __init__ and user_id"
  },
  {
   "name": "a bulleted list after a paragraph",
   "text": "Steps:\n\n- first\n- **second**\n- third",
   "blocks": [
    {
     "type": "p",
     "lines": [
      [
       {
        "t": "Steps:"
